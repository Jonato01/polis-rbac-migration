FROM python:3.9-slim

WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir \
    azure-storage-blob \
    azure-servicebus

# Copy script
COPY azure_clients.py ./
COPY storage_cleanup_service.py .

# Unbuffered output
ENV PYTHONUNBUFFERED=1

CMD ["python", "-u", "storage_cleanup_service.py"]
