FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (we'll create a requirements file specific for service)
COPY timesheet/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy shared module
COPY azure_clients.py ./
COPY ocr_common.py ./

# Copy timesheet specific code
COPY timesheet/timesheet.py ./
COPY timesheet/timesheet_wrapper.py ./
COPY timesheet/timesheet_service.py ./

EXPOSE 8080

CMD ["python", "-u", "timesheet_service.py"]

