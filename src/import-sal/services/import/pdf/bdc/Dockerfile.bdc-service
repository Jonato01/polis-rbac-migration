FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Set working directory
WORKDIR /app

# Install system dependencies (gcc for Python packages, openssl for P7M)
RUN apt-get update && apt-get install -y \
    gcc \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY bdc/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the common OCR module from parent directory
COPY azure_clients.py ./
COPY ocr_common.py ./

# Copy BDC specific files
COPY bdc/bdc_ocr.py ./
COPY bdc/bdc_ocr_wrapper.py ./
COPY bdc/bdc_service.py ./
COPY bdc/bdc_processor.py ./
COPY bdc/bdc_p7m_handler.py ./
COPY bdc/bdc_cup_validator.py ./
COPY bdc/bdc_addendum_cup_fixer.py ./

# Expose port (if needed for health checks)
EXPOSE 8080

# Run the service that listens to the queue
CMD ["python", "-u", "bdc_service.py"]
