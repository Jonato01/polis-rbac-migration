FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY aq/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the common OCR module from parent directory
COPY azure_clients.py ./
COPY ocr_common.py ./

# Copy AQ specific files
COPY aq/aq_ocr.py ./
COPY aq/aq_ocr_wrapper.py ./
COPY aq/aq_service.py ./

# Expose port (if needed for health checks)
EXPOSE 8080

# Run the service that listens to the queue
CMD ["python", "-u", "aq_service.py"]
